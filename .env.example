# Konfigurasi untuk IPK Optimizer — Machine Not Learn
# Copy file ini ke .env dan isi nilai sesuai environment Anda.

# === DATA SOURCE ===
# "file" = load dari CSV/Excel
# "db"   = load dari database PostgreSQL
# ""     = auto (coba DB dulu, fallback ke file)
DATA_SOURCE=file

# === FILE PATH ===
# Path ke dataset (CSV atau Excel)
# Format Indonesia: jurusan, semester_ke, mata_kuliah, nilai, bobot_nilai
DATA_PATH=data/indonesia/indonesia_course_records.csv

# === DATABASE ===
# URL koneksi PostgreSQL (opsional)
# DB_URL=postgresql://user:password@localhost:5432/gpa_optimizer

# === MODEL PATHS ===
# Path untuk save/load trained models (joblib)
MODEL1_PATH=models/trained/model1_indonesia.joblib
MODEL2_PATH=models/trained/model2_indonesia.joblib
MODEL3_PATH=models/trained/model3_randomforest.joblib

# === CROWDSOURCING DATA ===
# Path untuk menyimpan data transkrip yang dikontribusikan user (anonymized)
CROWDSOURCE_PATH=data/crowdsourced/contributed_transcripts.csv
